font-family = JetBrainsMono Nerd Font
font-size = 12
font-feature = liga
font-feature = calt

theme = Gruber Darker

# Canonical Gruber Darker palette by Jason Blevins and Alexey Kutepov (rexim).
# These override Ghostty's bundled terminal adaptation, whose colors differ.
background = #181818
foreground = #e4e4ef
cursor-color = #ffdd33
cursor-text = #181818
selection-background = #484848
selection-foreground = #e4e4ef
palette = 0=#181818
palette = 1=#f43841
palette = 2=#73c936
palette = 3=#ffdd33
palette = 4=#96a6c8
palette = 5=#9e95c7
palette = 6=#95a99f
palette = 7=#e4e4ef
palette = 8=#484848
palette = 9=#ff4f58
palette = 10=#73c936
palette = 11=#ffdd33
palette = 12=#96a6c8
palette = 13=#9e95c7
palette = 14=#95a99f
palette = 15=#f5f5f5

cursor-style = block
cursor-style-blink = false

background-opacity = 1.0

scrollback-limit = 50000000
copy-on-select = false
selection-invert-fg-bg = false

keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard

shell-integration-features = no-cursor

bell-features = no-system,no-audio,no-attention,no-title,no-border
confirm-close-surface = false
